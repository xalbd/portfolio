---
interface Props {
  href: string;
  body: string;
  icon: string;
  alt: string;
}

const { href, body, icon, alt } = Astro.props;
---

<a
  href={href}
  target="_blank"
  class="flex flex-row items-center my-2 max-w-fit hover:text-special-900"
>
  <img src={icon} alt={alt} class="w-5 h-5 mr-2" />
  <p>{body}</p>
</a>
