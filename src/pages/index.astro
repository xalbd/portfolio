---
import Layout from "../layouts/Layout.astro";
import Link from "../components/Link.astro";
---

<Layout title="Albert Dong">
  <main class="flex flex-col h-full">
    <h1 class="text-6xl font-extrabold text-theme-dark mb-5">Albert Dong</h1>
    <p class="text-2xl mb-1">Third-year computer science student at UCLA</p>
    <p class="text-lg mb-5">Incoming Roblox SWE Intern</p>
    <Link
      href="https://github.com/xalbd"
      body="github/xalbd"
      icon="github.svg"
      alt="GitHub"
    />
    <Link
      href="https://www.linkedin.com/in/albertdong04"
      body="in/albertdong04"
      icon="linkedin.svg"
      alt="LinkedIn"
    />
    <p class="pt-5 mt-auto">albertd [at] g.ucla.edu</p>
  </main>
</Layout>
