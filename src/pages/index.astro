---
import Layout from "../layouts/Layout.astro";
import Link from "../components/Link.astro";
---

<Layout title="Albert Dong">
  <main class="flex flex-col h-full">
    <h1 class="text-6xl font-bold text-theme-dark mb-5">Albert Dong</h1>
    <p class="text-2xl mb-5">Fourth-year computer science student at UCLA</p>
    <p>Currently:</p>
    <ul class="list-disc list-inside mb-2">
      <li>Learning Assistant Program Development Team</li>
      <li>Tutoring Chair @ UPE</li>
      <li>Advisor Officer @ ACM AI</li>
    </ul>
    <p>Previously:</p>
    <ul class="list-disc list-inside mb-5">
      <li>Roblox SWE Intern (Infrastructure &gt; Storage)</li>
    </ul>
    <div class="mt-auto">
      <Link
        href="https://github.com/xalbd"
        body="github/xalbd"
        icon="github.svg"
        alt="GitHub"
      />
      <Link
        href="https://www.linkedin.com/in/albertdong04"
        body="in/albertdong04"
        icon="linkedin.svg"
        alt="LinkedIn"
      />
      <p class="my-2">albertd [at] g.ucla.edu</p>
    </div>
  </main>
</Layout>
